__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# The audio cache and the finished audiobooks. Both are made from the source
# text and the configuration, so neither belongs in the repository.
/cache/
/out/
/.work/
examples/soultale/cache/
examples/soultale/out/
examples/soultale/.work/

# The recordings a voice is taken from. They are yours, they are large, and
# they are not the tool.
#
# The note beside them is kept. It says which voice speaks for which
# character, and a record that lives only where it can be cleared is not a
# record.
# The contents are ignored and not the directory itself. Git does not look
# inside a directory it has been told to ignore, so the exception below would
# never be read.
/voices/
examples/soultale/voices/*
!examples/soultale/voices/README.md

# Speech corpora. A voice is chosen from one of these and then copied into
# voices/. The corpus itself is tens of gigabytes and it comes from somewhere
# else, so it stays out of the repository.
/datasets/

# The manuscript of Soultale is in the repository on purpose, because this is
# the working space of its author. See examples/soultale/book/NOTICE.md: the
# book is not under the licence that covers the code. Any other EPUB is
# somebody's working copy and stays out.
*.epub
!examples/soultale/book/*.epub

# macOS writes these into every directory it looks at.
.DS_Store
